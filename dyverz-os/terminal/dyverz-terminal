#!/usr/bin/env python3
"""Dyverz Terminal — a Windows-Terminal-style tabbed terminal (GTK4 + libadwaita + VTE).

Profiles live in ~/.config/dyverz-terminal/settings.json (falls back to /etc/dyverz/terminal.json).
Shortcuts: Ctrl+Shift+T new tab (default profile) · Ctrl+Shift+W close tab · Ctrl+Tab / Ctrl+Shift+Tab switch
           Ctrl+Shift+1..9 open profile N · Ctrl+Shift+C / V copy & paste · Ctrl+, open settings · Ctrl+= / Ctrl+- zoom
"""
import json, os, shlex, sys
import gi
gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1"); gi.require_version("Vte", "3.91")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk, Pango, Vte

USER_CONF = os.path.expanduser("~/.config/dyverz-terminal/settings.json")
SYSTEM_CONF = "/etc/dyverz/terminal.json"
FALLBACK = {"defaultProfile": "arch", "font": "Cascadia Mono 11",
            "theme": {"background": "#0c0c0c", "foreground": "#cccccc", "cursor": "#ffffff", "opacity": 0.93, "palette": []},
            "profiles": [{"id": "arch", "name": "Shell", "icon": "", "command": os.environ.get("SHELL", "/bin/bash"), "tab": "#1793d1"}]}

CSS = b"""
window.dyverz { background: #202020; }
.dyverz-tabbar { background: #202020; padding: 4px 6px 0 6px; min-height: 36px; }
.dyverz-tab { background: transparent; color: #a8a8a8; border-radius: 6px 6px 0 0; padding: 4px 8px 4px 10px; margin-right: 2px; min-height: 28px; }
.dyverz-tab:hover { background: #2b2b2b; color: #e6e6e6; }
.dyverz-tab.active { background: #0c0c0c; color: #ffffff; }
.dyverz-tab .close { min-width: 18px; min-height: 18px; padding: 0; margin-left: 6px; border-radius: 4px; background: transparent; color: #a8a8a8; }
.dyverz-tab .close:hover { background: #3a3a3a; color: #fff; }
.dyverz-tab .dot { min-width: 8px; min-height: 8px; border-radius: 4px; margin-right: 6px; }
.dyverz-plus { background: transparent; color: #cfcfcf; border-radius: 6px; padding: 2px 6px; margin-left: 2px; }
.dyverz-plus:hover { background: #2b2b2b; }
.dyverz-titlebar { background: #202020; color: #e0e0e0; min-height: 0; padding: 0; border: none; box-shadow: none; }
.dyverz-titlebar .title { font-size: 12px; color: #cfcfcf; }
popover.menu { background: #2b2b2b; color: #eee; }
"""


def load_config():
    for path in (USER_CONF, SYSTEM_CONF):
        try:
            with open(path) as f:
                cfg = json.load(f)
            cfg.setdefault("theme", {}); cfg.setdefault("profiles", []); return cfg
        except FileNotFoundError:
            continue
        except Exception as ex:
            print(f"dyverz-terminal: bad config {path}: {ex}", file=sys.stderr)
    return FALLBACK


def rgba(hexstr, alpha=1.0):
    c = Gdk.RGBA(); c.parse(hexstr); c.alpha = alpha; return c


class Tab:
    def __init__(self, win, profile):
        self.win, self.profile = win, profile
        th = win.cfg["theme"]
        self.term = Vte.Terminal(vexpand=True, hexpand=True, scrollback_lines=10000, allow_hyperlink=True, scroll_on_output=False, scroll_on_keystroke=True)
        self.term.set_font(Pango.FontDescription(win.cfg.get("font", "Monospace 11")))
        self.term.set_cursor_blink_mode(Vte.CursorBlinkMode.ON); self.term.set_cursor_shape(Vte.CursorShape.UNDERLINE)
        pal = [rgba(c) for c in th.get("palette", [])] if len(th.get("palette", [])) == 16 else None
        self.term.set_colors(rgba(th.get("foreground", "#cccccc")), rgba(th.get("background", "#0c0c0c"), float(th.get("opacity", 1.0))), pal)
        self.term.set_color_cursor(rgba(th.get("cursor", "#ffffff")))
        self.term.connect("child-exited", lambda *_: win.close_tab(self))
        self.term.connect("window-title-changed", lambda t: self.set_title(t.get_window_title()))
        self.term.connect("bell", lambda *_: None)
        self.page = Gtk.ScrolledWindow(child=self.term, vexpand=True, hexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        # tab button
        self.btn = Gtk.Box(css_classes=["dyverz-tab"], spacing=0)
        self.btn.set_cursor(Gdk.Cursor.new_from_name("pointer"))
        dot = Gtk.Box(css_classes=["dot", "dot-" + profile["id"]], valign=Gtk.Align.CENTER)
        self.label = Gtk.Label(label=profile["name"], ellipsize=Pango.EllipsizeMode.END, max_width_chars=22, xalign=0)
        close = Gtk.Button(icon_name="window-close-symbolic", css_classes=["close", "flat"], valign=Gtk.Align.CENTER)
        close.connect("clicked", lambda *_: win.close_tab(self))
        for w in (dot, self.label, close): self.btn.append(w)
        click = Gtk.GestureClick(); click.connect("released", lambda *_: win.activate_tab(self)); self.btn.add_controller(click)
        mid = Gtk.GestureClick(button=2); mid.connect("released", lambda *_: win.close_tab(self)); self.btn.add_controller(mid)
        self.spawn()

    def set_title(self, t):
        self.label.set_text(t or self.profile["name"])
        if self.win.current is self: self.win.set_title(f"{t or self.profile['name']} — Dyverz Terminal")

    def spawn(self):
        argv = shlex.split(self.profile["command"])
        env = [f"{k}={v}" for k, v in os.environ.items() if k not in ("VTE_VERSION",)] + ["TERM=xterm-256color", "COLORTERM=truecolor", "DYVERZ_PROFILE=" + self.profile["id"]]
        self.term.spawn_async(Vte.PtyFlags.DEFAULT, self.profile.get("cwd") or os.path.expanduser("~"), argv, env,
                              GLib.SpawnFlags.SEARCH_PATH_FROM_ENVP, None, None, -1, None, self.on_spawned)

    def on_spawned(self, term, pid, err, *_):
        if err:
            term.feed(f"\r\n\x1b[31mCould not start {self.profile['command']}: {err.message}\x1b[0m\r\n".encode())


class Window(Adw.ApplicationWindow):
    def __init__(self, app, cfg):
        super().__init__(application=app, title="Dyverz Terminal", default_width=980, default_height=600, css_classes=["dyverz"])
        self.cfg, self.tabs, self.current = cfg, [], None
        hb = Gtk.HeaderBar(css_classes=["dyverz-titlebar"], show_title_buttons=True)
        self.tabbar = Gtk.Box(css_classes=["dyverz-tabbar"], spacing=0, hexpand=True)
        plus = Gtk.Button(icon_name="list-add-symbolic", css_classes=["dyverz-plus", "flat"], tooltip_text="New tab (Ctrl+Shift+T)")
        plus.connect("clicked", lambda *_: self.new_tab())
        menu = Gio.Menu()
        for i, p in enumerate(cfg["profiles"]):
            item = Gio.MenuItem.new(f"{p.get('icon', '')}  {p['name']}".strip(), f"win.profile::{p['id']}"); menu.append_item(item)
        sect = Gio.Menu(); sect.append("Settings (Ctrl+,)", "win.settings"); sect.append("About Dyverz Terminal", "win.about"); menu.append_section(None, sect)
        chev = Gtk.MenuButton(icon_name="pan-down-symbolic", menu_model=menu, css_classes=["dyverz-plus", "flat"], tooltip_text="Open a profile")
        tabs_scroller = Gtk.ScrolledWindow(child=self.tabbar, hscrollbar_policy=Gtk.PolicyType.EXTERNAL, vscrollbar_policy=Gtk.PolicyType.NEVER, hexpand=True, propagate_natural_width=True)
        left = Gtk.Box(); left.append(tabs_scroller); left.append(plus); left.append(chev)
        hb.set_title_widget(Gtk.Box()); hb.pack_start(left)
        self.stack = Gtk.Stack(vexpand=True, transition_type=Gtk.StackTransitionType.NONE)
        tv = Adw.ToolbarView(); tv.add_top_bar(hb); tv.set_content(self.stack); self.set_content(tv)
        # actions
        act = Gio.SimpleAction.new_stateful("profile", GLib.VariantType.new("s"), GLib.Variant.new_string("")); act.connect("activate", lambda a, v: self.new_tab(v.get_string())); self.add_action(act)
        for name, cb in (("settings", self.open_settings), ("about", self.about), ("new", lambda *_: self.new_tab()), ("close", lambda *_: self.close_tab(self.current)),
                         ("next", lambda *_: self.cycle(1)), ("prev", lambda *_: self.cycle(-1)), ("copy", lambda *_: self.current and self.current.term.copy_clipboard_format(Vte.Format.TEXT)),
                         ("paste", lambda *_: self.current and self.current.term.paste_clipboard()), ("zoomin", lambda *_: self.zoom(1.1)), ("zoomout", lambda *_: self.zoom(1 / 1.1)), ("zoomreset", lambda *_: self.zoom(0))):
            a = Gio.SimpleAction.new(name, None); a.connect("activate", cb); self.add_action(a)
        # Ctrl+Shift+1..9 → profile N.  Shift changes the digit keysym ("4" → "$"), so resolve the unshifted key from the keycode.
        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE); keys.connect("key-pressed", self.on_key); self.add_controller(keys)
        self.new_tab()

    def on_key(self, ctl, keyval, keycode, state):
        mods = state & Gtk.accelerator_get_default_mod_mask()
        if os.environ.get("DYVERZ_DEBUG"): print("key", keyval, keycode, int(state), int(mods), Gdk.Display.get_default().translate_key(keycode, Gdk.ModifierType(0), 0), file=sys.stderr)
        if int(mods) == int(Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK):
            res = Gdk.Display.get_default().translate_key(keycode, Gdk.ModifierType(0), 0)
            base = res[1] if res[0] else 0
            if os.environ.get("DYVERZ_DEBUG"): print("shortcut base", base, "tabs before", len(self.tabs), file=sys.stderr)
            if Gdk.KEY_1 <= base <= Gdk.KEY_9:
                self.open_nth(base - Gdk.KEY_0)
                if os.environ.get("DYVERZ_DEBUG"): print("tabs after", len(self.tabs), file=sys.stderr)
                return True
        return False

    def profile(self, pid=None):
        pid = pid or self.cfg.get("defaultProfile")
        return next((p for p in self.cfg["profiles"] if p["id"] == pid), self.cfg["profiles"][0])

    def new_tab(self, pid=None):
        t = Tab(self, self.profile(pid)); self.tabs.append(t)
        self.tabbar.append(t.btn); self.stack.add_child(t.page); self.activate_tab(t)

    def open_nth(self, i):
        if i <= len(self.cfg["profiles"]): self.new_tab(self.cfg["profiles"][i - 1]["id"])

    def activate_tab(self, t):
        for x in self.tabs: x.btn.remove_css_class("active")
        t.btn.add_css_class("active"); self.current = t; self.stack.set_visible_child(t.page); t.term.grab_focus()
        self.set_title(f"{t.label.get_text()} — Dyverz Terminal")

    def close_tab(self, t):
        if t is None or t not in self.tabs: return
        i = self.tabs.index(t); self.tabs.remove(t); self.tabbar.remove(t.btn); self.stack.remove(t.page)
        if not self.tabs: self.close(); return
        self.activate_tab(self.tabs[min(i, len(self.tabs) - 1)])

    def cycle(self, d):
        if self.current: self.activate_tab(self.tabs[(self.tabs.index(self.current) + d) % len(self.tabs)])

    def zoom(self, f):
        if self.current: self.current.term.set_font_scale(1.0 if f == 0 else self.current.term.get_font_scale() * f)

    def open_settings(self, *_):
        if not os.path.exists(USER_CONF):
            os.makedirs(os.path.dirname(USER_CONF), exist_ok=True)
            with open(USER_CONF, "w") as f: json.dump(self.cfg, f, indent=2)
        Gtk.FileLauncher.new(Gio.File.new_for_path(USER_CONF)).launch(self, None, None)

    def about(self, *_):
        Adw.AboutDialog(application_name="Dyverz Terminal", application_icon="utilities-terminal", version="0.1", developer_name="Dyverz OS",
                        comments="Tabbed terminal for Arch, Ubuntu, Kali, Python, Wine cmd and PowerShell.").present(self)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="os.dyverz.Terminal", flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.cfg = load_config()
    def do_startup(self):
        Adw.Application.do_startup(self)
        extra = "".join(f".dot-{p['id']} {{ background: {p.get('tab', '#888888')}; }}\n" for p in self.cfg["profiles"] if p["id"].replace("-", "").isalnum())
        prov = Gtk.CssProvider(); prov.load_from_data(CSS + extra.encode())
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        for action, keys in {"win.new": ["<Ctrl><Shift>t"], "win.close": ["<Ctrl><Shift>w"], "win.next": ["<Ctrl>Tab", "<Ctrl>Page_Down"], "win.prev": ["<Ctrl><Shift>Tab", "<Ctrl>Page_Up"],
                             "win.copy": ["<Ctrl><Shift>c"], "win.paste": ["<Ctrl><Shift>v"], "win.settings": ["<Ctrl>comma"], "win.zoomin": ["<Ctrl>equal", "<Ctrl>plus"], "win.zoomout": ["<Ctrl>minus"], "win.zoomreset": ["<Ctrl>0"]}.items():
            self.set_accels_for_action(action, keys)
    def do_activate(self):
        Window(self, self.cfg).present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
