#!/usr/bin/env python3
"""Dyverz Device Manager — GTK front-end for dyverz-drivers (scan / install / Win Kernel drivers)."""
import json, os, subprocess, sys, threading
import gi
gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1")
from gi.repository import Adw, Gtk, GLib

CLI = "/usr/local/bin/dyverz-drivers"

class Win(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Device Manager", default_width=860, default_height=600)
        tv = Adw.ToolbarView(); hb = Adw.HeaderBar(); tv.add_top_bar(hb)
        self.rescan = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Rescan"); self.rescan.connect("clicked", lambda *_: self.scan()); hb.pack_start(self.rescan)
        self.install = Gtk.Button(label="Install missing drivers", css_classes=["suggested-action"]); self.install.connect("clicked", lambda *_: self.run([ "pkexec", CLI, "install", "--yes"])); hb.pack_end(self.install)
        self.winbtn = Gtk.Button(label="Win Kernel drivers"); self.winbtn.connect("clicked", lambda *_: self.run([CLI, "win"])); hb.pack_end(self.winbtn)
        self.page = Adw.PreferencesPage(); self.groups = []
        self.logv = Gtk.TextView(editable=False, monospace=True); self.logsw = Gtk.ScrolledWindow(child=self.logv, min_content_height=160, visible=False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); box.append(Gtk.ScrolledWindow(child=self.page, vexpand=True)); box.append(self.logsw)
        tv.set_content(box); self.set_content(tv); self.scan()

    def scan(self):
        for g in self.groups: self.page.remove(g)
        self.groups = []
        try: data = json.loads(subprocess.check_output([CLI, "scan", "--json"], text=True))
        except Exception as e: data = {"devices": [], "install": [], "winkernel": [str(e)]}
        bycat = {}
        for d in data["devices"]: bycat.setdefault(d["category"], []).append(d)
        for cat, devs in bycat.items():
            g = Adw.PreferencesGroup(title=cat)
            for d in devs:
                r = Adw.ActionRow(title=d["device"], subtitle=f"driver: {d['driver'] or 'none'}   ·   {d['packages']}")
                ok = d["status"] in ("installed", "ok")
                r.add_suffix(Gtk.Image(icon_name="emblem-ok-symbolic" if ok else "dialog-warning-symbolic", css_classes=["success" if ok else "warning"]))
                g.add(r)
            self.page.add(g); self.groups.append(g)
        g = Adw.PreferencesGroup(title="Dyverz Win Kernel")
        for w in data.get("winkernel", []): g.add(Adw.ActionRow(title=w))
        self.page.add(g); self.groups.append(g)
        n = len(data.get("install", []))
        self.install.set_label(f"Install {n} missing package{'s' if n != 1 else ''}" if n else "All drivers installed"); self.install.set_sensitive(n > 0)

    def run(self, cmd):
        self.logsw.set_visible(True); self.logv.get_buffer().set_text(""); self.install.set_sensitive(False); self.winbtn.set_sensitive(False)
        def worker():
            p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            for line in p.stdout: GLib.idle_add(self.log, line)
            p.wait(); GLib.idle_add(self.log, f"\n[exit {p.returncode}]\n"); GLib.idle_add(self.done)
        threading.Thread(target=worker, daemon=True).start()
    def log(self, s):
        b = self.logv.get_buffer(); b.insert(b.get_end_iter(), s); self.logv.scroll_to_mark(b.get_insert(), 0, False, 0, 0)
    def done(self):
        self.winbtn.set_sensitive(True); self.scan()

class App(Adw.Application):
    def __init__(self): super().__init__(application_id="os.dyverz.DeviceManager")
    def do_activate(self): Win(self).present()
if __name__ == "__main__": sys.exit(App().run(sys.argv))
